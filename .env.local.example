# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: Supabase dashboard → Settings → API
# https://supabase.com/dashboard/project/<your-project>/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ── OpenRouter ────────────────────────────────────────────────────────────────
# Required for Attacker Mode (LLM calls)
OPENROUTER_API_KEY=sk-or-v1-...

# ── TTS ───────────────────────────────────────────────────────────────────────
# No key needed. Voice scenarios use Microsoft Edge Neural TTS (en-NG-AbeoNeural /
# en-NG-EzinneNeural) via msedge-tts — free, no account required.
